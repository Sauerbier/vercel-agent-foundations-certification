# Copy to .env.local and fill in. Never commit real values.

# Vercel deployment-protection bypass for the Swag Store API (server-only).
BYPASS_SECRET=
# Optional override; defaults to https://vercel-agentic-swag-store-api.vercel.app/api
API_BASE_URL=

# Password for /admin (server-only). Ask a teammate for the value.
ADMIN_PASSWORD=

# AI Gateway + Vercel Sandbox auth. `vercel env pull` writes this for local dev;
# on Vercel it is provided automatically. Alternatively set AI_GATEWAY_API_KEY.
VERCEL_OIDC_TOKEN=
